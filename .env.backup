# ========================================
# RATS++ Discord Bot Configuration
# ========================================
# Fill in your values below

# ========================================
# DISCORD CONFIGURATION (Required)
# ========================================
# Your Discord Bot Token from https://discord.com/developers/applications
RPP_DISCORD_TOKEN=MTQ5MjMyNDU4MDM5NDUzNjk2MA.GU6gVx.g9rQOh3w9CTQaR-s_u7WQXR6A_8wm73s9GutSs
# Your Discord Application Client ID
RPP_DISCORD_CLIENT_ID=1492324580394536960

# Discord Bot Username (displayed in some messages)
RPP_DISCORD_USERNAME=RATS++

# Require admin privileges for sensitive operations (true/false)
RPP_NEED_ADMIN_PRIVILEGES=true

# ========================================
# GENERAL BOT SETTINGS
# ========================================
# Bot language (en, es, fr, de, etc.)
RPP_LANGUAGE=en

# How often to poll Rust+ API (milliseconds)
RPP_POLLING_INTERVAL=7000

# Show detailed error stack traces in logs (true/false)
RPP_LOG_CALL_STACK=false

# Time to wait before reconnecting after disconnect (milliseconds)
RPP_RECONNECT_INTERVAL=15000

# ========================================
# WEB UI CONFIGURATION
# ========================================
# Enable the Web UI interface (true/false)
RPP_WEBUI_ENABLED=true

# Port for the Web UI server
RPP_WEBUI_PORT=3000

# ========================================
# ADVANCED SETTINGS
# ========================================
# Node environment (production/development)
NODE_ENV=production

# Timezone for logs and timestamps (e.g., America/New_York, Europe/London)
TZ=UTC
