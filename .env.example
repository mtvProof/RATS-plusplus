# ========================================
# RATS++ Discord Bot Configuration
# ========================================
# Copy this file to .env and fill in your values
# All environment variables are optional - defaults will be used if not set

# ========================================
# DISCORD CONFIGURATION (Required)
# ========================================
# Your Discord Bot Token from https://discord.com/developers/applications
RPP_DISCORD_TOKEN=your_discord_bot_token_here

# Your Discord Application Client ID
RPP_DISCORD_CLIENT_ID=your_discord_client_id_here

# Discord Bot Username (displayed in some messages)
RPP_DISCORD_USERNAME=RATS++

# Require admin privileges for sensitive operations (true/false)
RPP_NEED_ADMIN_PRIVILEGES=true

# ========================================
# GENERAL BOT SETTINGS
# ========================================
# Bot language (en, es, fr, de, etc.)
RPP_LANGUAGE=en

# How often to poll Rust+ API (milliseconds)
RPP_POLLING_INTERVAL=7000

# Show detailed error stack traces in logs (true/false)
RPP_LOG_CALL_STACK=false

# Time to wait before reconnecting after disconnect (milliseconds)
RPP_RECONNECT_INTERVAL=15000

# ========================================
# WEB UI CONFIGURATION
# ========================================
# Enable the Web UI interface (true/false)
RPP_WEBUI_ENABLED=true

# Port for the Web UI server
RPP_WEBUI_PORT=3000

# ========================================
# DISCORD ROLE IDs (Optional)
# ========================================
# These can be set per-guild in instances/*.json, but you can set defaults here
# Get role IDs by right-clicking a role in Discord (Developer Mode must be enabled)

# Default role for notifications
# RPP_DEFAULT_NOTIFICATION_ROLE=your_role_id_here

# Admin role for bot management
# RPP_ADMIN_ROLE=your_admin_role_id_here

# ========================================
# DISCORD CHANNEL IDs (Optional)
# ========================================
# These can be set per-guild in instances/*.json, but you can set defaults here
# Get channel IDs by right-clicking a channel in Discord (Developer Mode must be enabled)

# Default notification channel
# RPP_DEFAULT_NOTIFICATION_CHANNEL=your_channel_id_here

# ========================================
# ADVANCED SETTINGS
# ========================================
# Node environment (production/development)
NODE_ENV=production

# Timezone for logs and timestamps (e.g., America/New_York, Europe/London)
TZ=UTC

# Enable debug mode (more verbose logging)
# RPP_DEBUG=false

# Maximum number of concurrent Rust+ connections
# RPP_MAX_CONNECTIONS=10

# Command cooldown in seconds
# RPP_COMMAND_DELAY=1

# ========================================
# DOCKER VOLUME PATHS (Handled by docker-compose)
# ========================================
# These directories are managed by Docker volumes:
# - /app/credentials - Rust+ credentials
# - /app/instances - Bot instance configurations
# - /app/database - Bot database files
# - /app/logs - Bot logs
# - /app/maps - Map images
